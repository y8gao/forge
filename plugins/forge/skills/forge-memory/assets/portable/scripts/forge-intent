#!/usr/bin/env python3
"""Prevalidate and atomically publish a Forge INTENT replacement."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys
import tempfile


sys.dont_write_bytecode = True
LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from forge_files import atomic_write, validate_managed_path  # noqa: E402
from forge_memory import (  # noqa: E402
    MemoryValidationError,
    load_intent,
    load_mission,
)


class _ArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise ValueError(message)


def _parser() -> argparse.ArgumentParser:
    parser = _ArgumentParser(prog="forge-intent", add_help=True)
    parser.add_argument("project_root", metavar="PROJECT_ROOT")
    parser.add_argument("--replace-from", required=True, metavar="INTENT_FILE")
    return parser


def _error(message: str, *, code: int = 1) -> int:
    print(f"forge-intent ERROR: {message}", file=sys.stderr)
    return code


def main(arguments: list[str]) -> int:
    try:
        try:
            options = _parser().parse_args(arguments)
        except ValueError as error:
            return _error(str(error) or "invalid arguments", code=2)

        project_root = Path(options.project_root)
        if project_root.name.lower() == ".forge":
            raise ValueError("PROJECT_ROOT must not be a .forge directory")
        if not project_root.is_dir():
            raise ValueError(f"PROJECT_ROOT is not a directory: {project_root}")
        project_root = validate_managed_path(project_root, project_root)
        forge = validate_managed_path(project_root, project_root / ".forge")
        intent_path = validate_managed_path(forge, forge / "INTENT.md")
        mission_path = validate_managed_path(forge, forge / "MISSION.md")

        load_intent(intent_path)
        load_mission(mission_path)
        replacement_path = Path(options.replace_from)
        try:
            replacement_bytes = replacement_path.read_bytes()
        except OSError as error:
            raise ValueError(f"cannot read replacement INTENT: {error}") from None
        with tempfile.TemporaryDirectory() as directory:
            validation_path = Path(directory) / "INTENT.md"
            validation_path.write_bytes(replacement_bytes)
            load_intent(validation_path)

        atomic_write(project_root, intent_path, replacement_bytes)
    except (MemoryValidationError, OSError, UnicodeError, ValueError) as error:
        return _error(str(error))

    print(f"forge-intent updated {intent_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
