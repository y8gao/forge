from __future__ import annotations

from pathlib import Path
import sys


sys.dont_write_bytecode = True
LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from forge_files import atomic_write, validate_managed_path
from forge_memory import (
    load_intent,
    load_mission,
    render_initial_intent,
    render_initial_mission,
)


BEGIN_MARKER = "<!-- BEGIN FORGE MEMORY-FIRST -->"
END_MARKER = "<!-- END FORGE MEMORY-FIRST -->"
IGNORE_COMMENT = "# Forge active Mission: one per checkout, never shared\n"
IGNORE_RULE = ".forge/MISSION.md\n"
BRIDGE = (
    f"{BEGIN_MARKER}\n"
    "## Forge Memory-First\n"
    "Read `.forge/INTENT.md` and `.forge/MISSION.md` on entry and follow the "
    "current outcome and next action.\n"
    "Outcome and Next Action come from MISSION; change INTENT only for a "
    "user-confirmed durable project-level decision.\n"
    "Publish durable INTENT updates through forge-intent; never patch active "
    "INTENT as a draft.\n"
    "Before substantive implementation, ensure MISSION fits the confirmed "
    'request; if it has `mission_id: "initial"`, activate a real Mission first.\n'
    "Run `forge-memory-validate` after every active-memory write.\n"
    "Checkpoint user decisions, accepted visible delivery, pause, completion, "
    "or Mission replacement.\n"
    "Do not checkpoint reads, edits, tests, or narration.\n"
    "\n"
    "### One active Mission per checkout\n"
    "- M1 `.forge/MISSION.md` is this checkout's active Mission, not shared "
    "state: never commit it, and never borrow another checkout's Mission.\n"
    "- M2 Run `forge-init` in a new checkout or worktree before substantive "
    "work; run one concurrent agent per worktree.\n"
    "- M3 Archive or replace this checkout's Mission with `forge-compact "
    "--complete` before removing its worktree.\n"
    "\n"
    "### Design workflow collaboration\n"
    "- M4 Complete small, reversible, single-surface changes directly and "
    "report evidence. Write a design document first when a change touches "
    "public behavior, cannot be reversed, spans subsystems, or must survive a "
    "session handoff; get user approval before building.\n"
    "- M5 Design documents and plans belong in this project's document "
    "directory, which `.forge/INTENT.md` records; tool-private paths such as "
    "`docs/superpowers/` are not project records.\n"
    "- M6 After a design document is approved, project its outcome, decisions, "
    "and acceptance criteria into MISSION and INTENT before starting a plan.\n"
    "- M7 Every plan step maps to one Success Criterion in the active Mission.\n"
    "- M8 Report only evidence actually observed; local test output never "
    "claims more than `locally_verified`.\n"
    "- M9 Independent checking starts only when the user asks for it.\n"
    "- M10 Do not commit, push, or merge without explicit authorization.\n"
    f"{END_MARKER}"
)


def _error(message: str, *, code: int = 2) -> int:
    print(f"forge-init ERROR: {message}", file=sys.stderr)
    return code


def _validate_bridge(path: Path) -> bytes | None:
    if not path.exists():
        return None
    content = path.read_bytes()
    begin = BEGIN_MARKER.encode("utf-8")
    end = END_MARKER.encode("utf-8")
    begin_count = content.count(begin)
    end_count = content.count(end)
    if begin_count == 0 and end_count == 0:
        return content
    if begin_count == 1 and end_count == 1 and content.index(begin) < content.index(end):
        return content
    raise ValueError(f"malformed Forge Memory-First markers in {path}")


def _ensure_ignore_rule(project_root: Path, path: Path) -> bool:
    """Keep this checkout's active Mission out of version control."""
    try:
        content = path.read_bytes() if path.exists() else b""
    except OSError as error:
        raise ValueError(f"cannot read {path}: {error}") from None
    try:
        text = content.decode("utf-8")
    except UnicodeError as error:
        raise ValueError(f"{path} is not UTF-8: {error}") from None
    if any(line.strip() == IGNORE_RULE.strip() for line in text.splitlines()):
        return False
    separator = b"\n" if content and not content.endswith(b"\n") else b""
    atomic_write(
        project_root,
        path,
        content + separator + (IGNORE_COMMENT + IGNORE_RULE).encode("utf-8"),
    )
    return True


def _append_bridge(project_root: Path, path: Path) -> None:
    content = _validate_bridge(path)
    desired = BRIDGE.encode("utf-8")
    if content is not None:
        begin = BEGIN_MARKER.encode("utf-8")
        end = END_MARKER.encode("utf-8")
        if begin in content:
            start = content.index(begin)
            stop = content.index(end, start) + len(end)
            if content[start:stop] == desired:
                return
            atomic_write(
                project_root,
                path,
                content[:start] + desired + content[stop:],
            )
            return
        separator = b"\n\n" if content and not content.endswith(b"\n") else b"\n"
        atomic_write(
            project_root,
            path,
            content + separator + desired,
        )
        return
    atomic_write(project_root, path, desired)


def main(arguments: list[str]) -> int:
    if len(arguments) != 1:
        return _error("expected exactly one PROJECT_ROOT")

    project_root = Path(arguments[0])
    if project_root.name.lower() == ".forge":
        return _error("PROJECT_ROOT must not be a .forge directory")
    if not project_root.exists():
        return _error(f"PROJECT_ROOT does not exist: {project_root}", code=1)
    if not project_root.is_dir():
        return _error(f"PROJECT_ROOT is not a directory: {project_root}", code=1)

    try:
        forge = project_root / ".forge"
        intent = forge / "INTENT.md"
        mission = forge / "MISSION.md"
        archive = forge / "archive"
        decisions = forge / "decisions"
        agents = project_root / "AGENTS.md"
        claude = project_root / "CLAUDE.md"
        for path in (
            project_root,
            forge,
            intent,
            mission,
            archive,
            decisions,
            agents,
            claude,
        ):
            validate_managed_path(project_root, path)
        _validate_bridge(agents)
        _validate_bridge(claude)
        if intent.exists():
            load_intent(intent)
        if mission.exists():
            load_mission(mission)
        forge.mkdir(exist_ok=True)
        archive.mkdir(exist_ok=True)
        if not intent.exists():
            atomic_write(
                project_root,
                intent,
                render_initial_intent().encode("utf-8"),
            )
        if not mission.exists():
            atomic_write(
                project_root,
                mission,
                render_initial_mission().encode("utf-8"),
            )
        _append_bridge(project_root, agents)
        _append_bridge(project_root, claude)
        active_mission = load_mission(mission)
    except (OSError, UnicodeError, ValueError) as error:
        return _error(str(error), code=1)

    ignore_changed = False
    try:
        ignore_changed = _ensure_ignore_rule(project_root, project_root / ".gitignore")
    except (OSError, UnicodeError, ValueError) as error:
        print(
            "forge-init WARNING: cannot keep `.forge/MISSION.md` out of version "
            f"control: {error}",
            file=sys.stderr,
        )

    print(f"forge-init initialized {project_root}")
    if ignore_changed:
        print(
            "forge-init ignore rule added: `.forge/MISSION.md` stays local to "
            "this checkout"
        )
        print(
            "forge-init NEXT: if `.forge/MISSION.md` is already tracked, run: "
            "git rm --cached .forge/MISSION.md"
        )
    if active_mission.mission_id == "initial":
        print("forge-init NEXT: activate the placeholder Mission before substantive work")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
