from __future__ import annotations

from pathlib import Path
import sys


LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from forge_memory import MemoryValidationError, load_intent, load_mission


def main(arguments: list[str]) -> int:
    if len(arguments) != 1:
        print(
            "forge-memory-validate ERROR: expected exactly one PROJECT_ROOT",
            file=sys.stderr,
        )
        return 2

    project_root = Path(arguments[0])
    if project_root.name.lower() == ".forge":
        print(
            "forge-memory-validate ERROR: "
            "PROJECT_ROOT must not be a .forge directory",
            file=sys.stderr,
        )
        return 2

    try:
        load_intent(project_root / ".forge" / "INTENT.md")
        load_mission(project_root / ".forge" / "MISSION.md")
    except MemoryValidationError as error:
        print(f"forge-memory-validate ERROR: {error}", file=sys.stderr)
        return 1

    print("forge-memory-validate PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
